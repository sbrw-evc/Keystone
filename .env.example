# Keystone for docker compose (install.sh makes .env from this). Everything else — the database, OpenBao, the public
# address, proxies, the administrator — is set in the setup wizard and in Settings.

# The password of the PostgreSQL of the compose file; the setup wizard asks for it once and keeps it in OpenBao.
POSTGRES_PASSWORD=

# The port docker compose publishes (default 8080).
# SPA_PORT=8080
