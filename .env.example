# SPA settings for docker compose (copy to .env). See backend/cmd/spa/main.go for the full list.

# The address of SPA and its OpenID Connect issuer, exactly as applications and browsers reach it.
SPA_PUBLIC_URL=http://localhost:8080
# The port docker compose publishes.
SPA_PORT=8080

# Seals secrets (client secrets, the signing key, directory passwords) in the database:
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`. Keep it safe: without it the secrets are lost.
SPA_MASTER_KEY=
# Or keep the secrets in OpenBao (KV v2) instead:
# BAO_ADDR=https://bao.example.com:8200
# BAO_TOKEN=
# BAO_MOUNT=spa

# The first administrator, created when SPA has no people; the password is changed at the first sign-in.
SPA_ADMIN_USERNAME=admin
SPA_ADMIN_PASSWORD=

# How long an SPA session lasts, in hours.
SPA_SESSION_HOURS=12
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Host are trusted (comma-separated networks).
# SPA_TRUSTED_PROXIES=10.0.0.0/8

# The PostgreSQL password of the compose database.
POSTGRES_PASSWORD=spa
